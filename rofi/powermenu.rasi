@import "colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 14";
    background-color: transparent;
    text-color: @fg;
}

window {
    location: center;
    anchor: center;
    width: 46%;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 18px;
    padding: 22px;
}

mainbox {
    spacing: 18px;
    children: [ message, listview ];
}

message {
    background-color: @bg-alt;
    border-radius: 12px;
    padding: 10px 14px;
}

textbox {
    horizontal-align: 0.5;
    text-color: @fg-dim;
}

listview {
    columns: 4;
    lines: 1;
    spacing: 14px;
    fixed-columns: true;
    scrollbar: false;
}

element {
    padding: 28px 10px;
    border-radius: 14px;
    background-color: @bg-alt;
}

element selected.normal {
    background-color: @accent;
    text-color: @bg;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: inherit;
}
