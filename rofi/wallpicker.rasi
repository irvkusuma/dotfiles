@import "colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 960px;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 18px;
    padding: 20px;
}

mainbox {
    spacing: 16px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border-radius: 12px;
    padding: 10px 14px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Cari wallpaper...";
    placeholder-color: @fg-dim;
}

listview {
    columns: 4;
    lines: 3;
    spacing: 14px;
    fixed-columns: true;
    scrollbar: false;
}

element {
    orientation: vertical;
    spacing: 8px;
    padding: 10px;
    border-radius: 14px;
    background-color: @bg-alt;
}

element selected.normal {
    background-color: @accent;
    text-color: @bg;
}

element-icon {
    size: 11em;
    border-radius: 10px;
    horizontal-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
    text-color: inherit;
}
