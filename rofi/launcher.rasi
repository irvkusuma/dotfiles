@import "colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color: @fg;
}

window {
    location: center;
    anchor: center;
    width: 620px;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 18px;
    padding: 18px;
}

mainbox {
    spacing: 14px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border-radius: 12px;
    padding: 12px 16px;
    spacing: 12px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Cari aplikasi...";
    placeholder-color: @fg-dim;
}

listview {
    lines: 7;
    columns: 1;
    spacing: 6px;
    fixed-height: true;
    scrollbar: false;
}

element {
    orientation: horizontal;
    spacing: 14px;
    padding: 8px 12px;
    border-radius: 10px;
    background-color: transparent;
}

element normal.active {
    text-color: @accent-2;
}

element selected.normal {
    background-color: @accent;
    text-color: @bg;
}

element selected.active {
    background-color: @accent;
    text-color: @bg;
}

element-icon {
    size: 2.2em;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
}
